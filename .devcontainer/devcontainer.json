{
  "name": "Retrace Model Decision Demo",
  "dockerComposeFile": [
    "../compose.yaml",
    "compose.yaml"
  ],
  "service": "workspace",
  "remoteUser": "vscode",
  "runServices": [
    "workspace",
    "model-gateway"
  ],
  "workspaceFolder": "/app",
  "shutdownAction": "stopCompose",
  "postCreateCommand": "python -m scripts.prepare_examples",
  "hostRequirements": {
    "cpus": 2,
    "memory": "3gb",
    "storage": "3gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "RetraceSoftware.retrace-debug-extension",
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.analysis.languageServerMode": "light",
        "python.analysis.indexing": false,
        "debug.allowBreakpointsEverywhere": true,
        "editor.glyphMargin": true,
        "remote.extensionKind": {
          "RetraceSoftware.retrace-debug-extension": [
            "workspace"
          ]
        }
      }
    }
  }
}
